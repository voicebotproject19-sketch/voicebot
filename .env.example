# ═══════════════════════════════════════════════════════════════════════════════
# VoiceBot Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# All values shown are recommended production defaults unless stated otherwise.
# Lines marked (REQUIRED) have no fallback — the app will crash or malfunction.
# Lines marked (code default: X) show what the code uses if the var is unset.
#
# Regenerated: 9 May 2026  |  286 active vars + platform signals  |  Validated against codebase
# ═══════════════════════════════════════════════════════════════════════════════


# ─── 1. SERVER & NETWORKING ─────────────────────────────────────────────────

# HTTP port for Express server. (code default: 4000 — app.js)
PORT=4000
# Public hostname used in Twilio/Plivo callback URLs and WebSocket URLs.
# (REQUIRED — MainController.js, TwilioProvider.js, PlivoProvider.js)
NETWORK_URL=your-host.example.com
# Node environment. Affects telemetry adapter sampling and PM2 config.
# Options: development, production, staging
NODE_ENV=production
# Comma-separated exact browser origins for CORS. Use scheme+host(+port) only.
# Paths, query strings, and fragments are rejected at startup with a warning.
CORS_ALLOWED_ORIGINS=https://domainname.com
# PM2 demo default. Set to 2+ or max only when clustered boot can verify durable context.
PM2_INSTANCES=1
# Set by ecosystem.config.js for PM2 cluster deployments. Leave false for single-process node start.
VOICEBOT_CLUSTER_MODE=false
# Advisory note after migration 009_call_context_snapshots.sql is applied.
# Clustered boot still verifies call_context_snapshots in the configured DB.
VOICEBOT_CLUSTER_DURABLE_CONTEXT_ACK=false
# Platform/runtime signals read for instance identity or cluster detection.
# Do not set these in normal .env files; Azure, PM2, or the host sets them when applicable.
# HOSTNAME=
# WEB_CONCURRENCY=
# WORKERS=
# NODE_APP_INSTANCE=
# PM2_HOME=


# ─── 2. AUTHENTICATION ──────────────────────────────────────────────────────

# API key for authenticating inbound API requests (middleware/auth.js).
# If unset, all apiAuth-protected routes return 500.
# Never sent to browser clients — demobot HTML pages use server-side proxy.
APP_API_KEY=


# ─── 3. TELECOM PROVIDERS ───────────────────────────────────────────────────

# ── Twilio (only needed when using Twilio calls) ──
TWILIO_ACCOUNT_SID=
# Canonical Twilio auth token. (middleware/auth.js validates signatures)
TWILIO_ACCOUNT_AUTH_TOKEN=
# Backward-compatible alias — code checks both. Set one or the other.
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Plivo (only needed when using Plivo calls) ──
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=


# ─── 4. AI PROVIDER SELECTION ───────────────────────────────────────────────

# Controls which realtime AI backend is used for all calls.
# Options:
#   azure-realtime    — Azure Voice Live via unified adapter (default)
#   openai-realtime   — OpenAI Realtime API (PCM16 transcoding)
#   legacy            — fallback to legacy per-telecom services
# (code default: 'azure-realtime')
AI_PROVIDER=azure-realtime


# ─── 5. AZURE REALTIME (primary AI path) ────────────────────────────────────

# Azure Realtime / Voice Live WebSocket endpoint.
# Existing endpoints may include a model query; otherwise set AZURE_VOICE_LIVE_MODEL below for Voice Live canaries.
# (REQUIRED when AI_PROVIDER=azure-realtime — AzureRealtimeAdapter.js)
AZURE_REALTIME_ENDPOINT=
AZURE_REALTIME_KEY=

# Optional Voice Live model override for canarying gpt-realtime-mini.
# Leave empty to preserve the model already embedded in AZURE_REALTIME_ENDPOINT.
# Voice Live endpoint shape: .../voice-live/realtime?api-version=2025-10-01&model=gpt-realtime-mini
AZURE_VOICE_LIVE_MODEL=
# Used only when the effective Voice Live model is gpt-realtime or gpt-realtime-mini.
AZURE_VOICE_LIVE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional legacy Azure OpenAI realtime deployment label used only in adapter logs/model diagnostics.
# Prefer AZURE_VOICE_LIVE_MODEL or the model query in AZURE_REALTIME_ENDPOINT.
AZURE_OPENAI_REALTIME_DEPLOYMENT=

# Azure TTS voice ID for English. Used by AzureRealtimeAdapter._getProviderVoice().
# (code default: 'en-US-JennyNeural')
AZURE_VOICE_ENGLISH=en-US-JennyNeural
# Azure TTS voice ID for German. Read by persona configs (NOT by adapter directly).
# (code default: 'de-DE-KatjaNeural' — company-sales.js, exed-webinar.js)
AZURE_VOICE_GERMAN=de-DE-KatjaNeural

# Azure VAD mode. Options: true (server_vad), azure_semantic_vad, azure_semantic_vad_multilingual, false/none.
# azure_semantic_vad enables smarter end-of-turn, filler word removal, auto-truncate.
# azure_semantic_vad_multilingual adds multilingual support.
# (code default: 'server_vad' — resolveVADMode in BaseRealtimeAdapter.js)
AZURE_SERVER_VAD=azure_semantic_vad


# ─── 5A. TWO-PHASE VOICE LIVE ROUTING (disabled by default) ───────────────

# Phase 0 flags only. Disabled defaults preserve current realtime behavior.
TWO_PHASE_RESPONSE_ENABLED=false
TWO_PHASE_ACK_ENABLED=false
TWO_PHASE_TOOL_ROUTING_ENABLED=false
TWO_PHASE_SHADOW_MODE=true
TWO_PHASE_PROVIDER_ALLOWLIST=azure-realtime,openai-realtime
TWO_PHASE_ACK_MAX_MS=300
TWO_PHASE_ACK_GAP_MS=80
TWO_PHASE_TOOL_TIMEOUT_MS=800


# ─── 6. OPENAI REALTIME (alternate AI path) ─────────────────────────────────

# Only needed when AI_PROVIDER=openai-realtime.
# Falls back to OPENAI_API_KEY if OPENAI_REALTIME_API_KEY is empty.
OPENAI_REALTIME_API_KEY=
OPENAI_API_KEY=
# Model for OpenAI Realtime sessions. Also used by modelRouter.js.
# ⚠ gpt-4o-realtime-preview was DEPRECATED and shut down May 7 2026.
# (code default: 'gpt-realtime-1.5')
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
# Optional: override WebSocket URL (proxies or custom deployments).
OPENAI_REALTIME_ENDPOINT=
# Voice ID for OpenAI Realtime TTS.
# Options: alloy, echo, fable, onyx, nova, shimmer, ash, ballad, coral, sage, verse
# (code default: 'nova')
OPENAI_REALTIME_VOICE=nova
# Server-side noise reduction. Options: near_field (headphones), far_field (room mic)
# (code default: 'near_field')
OPENAI_NOISE_REDUCTION=near_field


# ─── 7. AZURE OPENAI (non-realtime LLM calls) ──────────────────────────────
# Used by hangupDecision.js and contextSummarizer.js for chat completions.

# (REQUIRED for hangup analysis and context summarization)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Azure OpenAI API version. (code default: '2025-04-01-preview')
# ⚠ Only affects contextSummarizer.js. hangupDecision.js hardcodes this version.
OPENAI_API_VERSION=2025-04-01-preview
# Model for hangup decision. Falls through to OPENAI_HANGUP_MODEL if unset.
AZURE_CLASSIFIER_MODEL=
# Model for hangup decision and context summarization.
# Options: gpt-4o-mini (default), gpt-4o, or your deployed Azure classifier model
# (code default: "gpt-4o-mini")
OPENAI_HANGUP_MODEL=gpt-4o-mini
# Perform hangup analysis every Nth user turn. Higher = fewer API calls.
# (code default: 3 — quickDecisionFilter.js)
OPENAI_HANGUP_ANALYSIS_INTERVAL=3

# ── Rate Limiting (Utils/rateLimiter.js) ──
# Maximum concurrent OpenAI API calls. (code default: 3)
OPENAI_MAX_CONCURRENT=3
# Maximum API calls per minute. (code default: 20)
OPENAI_MAX_PER_MINUTE=20


# ─── 8. VAD / TURN-DETECTION TUNING ─────────────────────────────────────────

# Client-side silence commit timer for vadMode=none (ms). (code default: 400)
# NOT the same as VAD_SILENCE_DURATION (server-side). Only used when AZURE_SERVER_VAD=false.
AZURE_VAD_SILENCE_MS=400
# Azure VAD voice detection threshold (0.0–1.0). (code default: 0.5)
# Used by both server_vad and azure_semantic_vad.# 0.6 reduces false triggers from background noise on PSTN lines while
# still catching soft-spoken callers. Trade-off: very quiet speech may
# need slightly longer to trigger.
AZURE_VAD_THRESHOLD=0.6
# Semantic VAD eagerness: low, medium, high, auto. (code default: 'medium')
# Only used with OpenAI Realtime API (AI_PROVIDER=openai-realtime, semantic_vad type).
# NOT applicable for Azure Voice Live azure_semantic_vad — use VAD_SILENCE_DURATION instead.
AZURE_VAD_EAGERNESS=medium
# Remove filler words (ah/umm/uh) during active responses. (code default: true)
# Only effective with azure_semantic_vad. Set to false to disable.
AZURE_VAD_REMOVE_FILLER_WORDS=true
# Minimum speech duration before VAD triggers (ms). (code default: 80 for semantic_vad)
# Increase to reduce false positives from short noises.
AZURE_VAD_SPEECH_DURATION_MS=80
# Server-side auto-truncate on barge-in. (code default: false)
# When true, server handles truncation automatically — eliminates 150ms client
# debounce latency. Manual truncation code in _handleSpeechStarted still safe.
AZURE_VAD_AUTO_TRUNCATE=true
# Language hints for VAD filler word removal. Comma-separated ISO codes.
# Blank = auto-detect from call language. Example: en,de
AZURE_VAD_LANGUAGES=
# Server-side noise reduction for Azure Voice Live. (code default: azure_deep_noise_suppression)
# Only type available for Voice Live API.
AZURE_NOISE_REDUCTION=azure_deep_noise_suppression
# Prefix padding before voice activity (ms). (code default: 200)
# Production override: 300ms captures more speech onset, reducing clipping.
# Only used when AZURE_SERVER_VAD=true (server_vad mode).
VAD_PREFIX_PADDING=300
# Server-side silence duration to finalize turn (ms). (code default: 400)
# Azure default for azure_semantic_vad is 500ms. Previously 600ms, reduced to
# match Azure default — 100ms latency improvement per turn with no quality risk.
# Used by both server_vad and azure_semantic_vad modes.
VAD_SILENCE_DURATION=500
# Per-language overrides — constructed dynamically as VAD_*_{LANG}.
# Leave blank to use the base values above.
VAD_PREFIX_PADDING_EN=
VAD_PREFIX_PADDING_DE=
VAD_SILENCE_DURATION_EN=
VAD_SILENCE_DURATION_DE=
VAD_THRESHOLD_EN=
VAD_THRESHOLD_DE=

# ── VAD A/B Experiments ──
# Override silence duration (ms) for A/B cohort. 0 = disabled. (code default: 0)
VAD_SILENCE_AB_MS=0
# % of calls routed to silence A/B cohort (0–100). (code default: 0)
VAD_SILENCE_AB_PERCENT=0
# % of calls routed to semantic VAD A/B cohort. (code default: 0)
VAD_SEMANTIC_AB_PERCENT=0


# ─── 9. VOICE & RESPONSE TUNING ─────────────────────────────────────────────

# Azure TTS speaking rate. Range: 0.5–1.5 (string). Blank = API default (~1.0).
# Higher = faster speech. 1.0 = default. Keep blank or 1.0 for natural pace.
# Values above 1.0 feel rushed on phone calls.
AZURE_VOICE_RATE=
# SLM temperature for AI response generation. (code default: 0.7)
# Lower = more deterministic. Range: 0.0–1.0.
SLM_TEMPERATURE=0.7
# Maximum tokens per AI response. Clamped to 100–1000 range.
# (code default: 400 — BaseRealtimeAdapter.js _getAdaptiveTokenLimit)
MAX_RESPONSE_OUTPUT_TOKENS=400
# Maximum total token budget across all AI responses in a call.
# (code default: 25000, hard cap: 50000)
MAX_TOTAL_TOKEN_BUDGET=25000
# Maximum bot turns before auto-hangup. (code default: 20)
MAX_BOT_TURNS=20
# Speech-start debounce to avoid false triggers (ms). (code default: 150)
# With AZURE_VAD_AUTO_TRUNCATE=true, server handles truncation so client
# debounce can be tighter. 100ms still filters PSTN click artifacts.
SPEECH_START_DEBOUNCE_MS=100
# Maximum noisy turns before auto-disconnect. (code default: 5)
MAX_TOTAL_NOISY_TURNS=5
# Maximum hold-music duration while waiting for a realtime connection (ms). (code default: 30000)
HOLD_MUSIC_MAX_DURATION_MS=30000


# ─── 10. RESPONSE LIFECYCLE & TIMEOUTS ──────────────────────────────────────

# Greeting fallback timeout — how long to wait before sending fallback greeting.
# (code default: 500ms — BaseRealtimeAdapter.js)
# Human benchmark: first spoken word within 300-500ms of call connect.
# 350ms is aggressive but achievable — first impression sets call tone.
GREETING_FALLBACK_TIMEOUT_MS=350
# Session initialization timeout before forcing realtime reconnect (ms). (code default: 5000)
SESSION_INIT_TIMEOUT_MS=5000
# Maximum wait for AI response before triggering timeout handler.
# (code default: 10000ms)
# Human benchmark: callers perceive abandonment after 6-7s of silence.
# 7s gives Phi-4-mm adequate headroom while avoiding perceived freezes.
RESPONSE_TIMEOUT_MS=7000
# Max wait for transcript after speech window closes (ms). (code default: 2000)
SPEECH_WINDOW_TRANSCRIPT_TIMEOUT_MS=2000
# Handover transfer number for escalation. Null = no transfer available.
HANDOVER_TRANSFER_NUMBER=
# Warm transfer is opt-in. Disabled keeps current cold transfer behavior.
WARM_TRANSFER_ENABLED=false
# Supported first-slice modes: cold, warm. Warm requires agent target numbers.
WARM_TRANSFER_MODE=warm
# Comma-separated or JSON-array agent numbers used for warm transfer screening.
WARM_TRANSFER_AGENT_NUMBERS=
# Seconds to ring/screen an agent before falling back.
WARM_TRANSFER_TIMEOUT_SECONDS=20
# Agent must press this key on providers that support confirmation.
WARM_TRANSFER_CONFIRM_KEY=1
# Seconds to wait for the agent confirmation key.
WARM_TRANSFER_CONFIRM_TIMEOUT_SECONDS=8
# Maximum entries in the in-memory call registry. (code default: 1000)
CALL_REGISTRY_MAX_ENTRIES=1000
# Max queued audio chunks before the AI WebSocket is connected. (code default: 500)
PRECONNECT_AUDIO_QUEUE_CAP=500


# ─── 11. WEBSOCKET & ADAPTER TIMEOUTS ───────────────────────────────────────

# WebSocket keep-alive ping interval. (code default: 30000ms)
WS_PING_INTERVAL_MS=30000
# WebSocket pong timeout before reconnect. (code default: 10000ms)
WS_PING_TIMEOUT_MS=10000
# Barge-in recovery window — ignore follow-up speech for this duration.
# (code default: 4000ms)
# Human benchmark: humans recover from interrupts in 1-2s. With server-side
# auto_truncate=true, the recovery can be faster. 2.5s balances reliability
# with responsiveness.
BARGE_IN_RECOVERY_MS=2500
# Recheck interval while waiting for barge-in recovery to clear (ms). (code default: 500)
BARGE_IN_RECOVERY_RECHECK_MS=500
# Max barge-in recovery wait before releasing deferred audio (ms). (code default: max(12000, BARGE_IN_RECOVERY_MS * 4))
BARGE_IN_RECOVERY_MAX_WAIT_MS=12000
# Grace period after screening detection before proceeding.
# (code default: 10000ms)
SCREENING_GRACE_MS=10000
# First silence timeout — auto-prompt if no user speech after greeting.
# (code default: 12000ms)
# Human benchmark: 8-10s without response triggers re-engagement in call centers.
# 8s prevents awkward silence while allowing processing time.
FIRST_SILENCE_TIMEOUT_MS=8000
# Second silence timeout — auto-hangup if still no speech.
# (code default: 15000ms)
# Human benchmark: callers hang up after 10-12s of total silence.
SECOND_SILENCE_TIMEOUT_MS=12000
# Recent speech/gate guardrails that suppress false silence prompts. Defaults come from BaseRealtimeAdapter.js.
SILENCE_RECENT_SPEECH_START_GRACE_MS=1200
SILENCE_RECENT_GATE_FRAMES=8
SILENCE_RECENT_GATE_ACTIVITY_MIN_ENERGY=0.003
SILENCE_RECENT_INPUT_ENERGY=0.015
SILENCE_RECENT_GATE_ACTIVITY_MS=1200
SILENCE_RECENT_TRANSCRIPT_GRACE_MS=5000
# Delay after the adapter emits silence_hangup before provider hangup API call.
# The adapter already waits for goodbye audio + grace, so code default is immediate.
# (code default: 0ms)
SILENCE_HANGUP_SIGNAL_DELAY_MS=0
# Delay before finalizing after provider terminal status callbacks (ms). (code default: 5000)
PROVIDER_TERMINAL_FINALIZATION_GRACE_MS=5000


# ─── 12. ECHO GUARD ─────────────────────────────────────────────────────────
# Prevents bot's own audio from being transcribed as user speech.

# Initial echo guard window (ms). (code default: 1500)
# ⚠ .env.example previously said 300, but code default is 1500.
ECHO_GUARD_INITIAL_MS=1500
# Minimum echo guard window after adaptation (ms). (code default: 800)
# ⚠ .env.example previously said 200, but code default is 800.
ECHO_GUARD_MIN_MS=800
# Number of turns before echo guard adapts to measured latency. (code default: 5)
# ⚠ .env.example previously said 3, but code default is 5.
ECHO_GUARD_ADAPT_TURNS=5


# ─── 13. TWILIO NOISE-GATE TUNING ───────────────────────────────────────────
# Twilio-specific audio gate parameters (TwilioProvider.js).

# Dynamic threshold offset for noise gate. (code default: 0.02)
GATE_DYNAMIC_THRESHOLD_OFFSET=0.02
# Number of silent frames before gate closes. (code default: 20)
GATE_SILENCE_FRAMES_THRESHOLD=20
# Energy level that forces gate open regardless of threshold. (code default: 0.03)
# Set to null/none/disabled/off to disable this branch; explicit 0 is respected.
GATE_ENERGY_OVERRIDE_THRESHOLD=0.03
# Maximum consecutive silent frames before failsafe triggers. (code default: 50)
# Set to null/none/disabled/off to disable this branch.
GATE_MAX_SILENCE_FAILSAFE=50

# Optional call-scoped numeric GateV2 trace. Emits no raw audio or transcript text.
# Comma-separated call IDs. Leave unset in production unless capturing named calls.
GATE_DEBUG_TRACE_CALL_IDS=
# Optional sample rate for allowlisted calls, 0..1. (code default: 1)
GATE_DEBUG_TRACE_SAMPLE_RATE=1
# Drop media payloads larger than this before base64 decoding. (code default: 8192)
GATE_MAX_MEDIA_PAYLOAD_CHARS=8192
# Gate diagnostics thresholds for high-energy drops and high noise floor. (code defaults: 0.05)
GATE_DIAGNOSTIC_HIGH_ENERGY_DROP_THRESHOLD=0.05
GATE_DIAGNOSTIC_HIGH_NOISE_FLOOR_THRESHOLD=0.05
# Delay before emitting turn-level gate summaries (ms). (code default: 250)
GATE_TURN_SUMMARY_DELAY_MS=250


# ─── 14. PLIVO NOISE-GATE TUNING ────────────────────────────────────────────
# Plivo-specific audio gate overrides (PlivoProvider.js).
# Defaults match Twilio gate unless specified.

# (code default: 0.02)
PLIVO_GATE_DYNAMIC_THRESHOLD_OFFSET=0.02
# (code default: 50)
PLIVO_GATE_SILENCE_FRAMES_THRESHOLD=50
# Blank/unset values use the code default. Set nullable fields to null/none/disabled/off to disable.
# energyOverrideThreshold: null (disabled) if unset; 0 would disable noise gate entirely.
PLIVO_GATE_ENERGY_OVERRIDE_THRESHOLD=
# maxSilenceFailsafe: 150 if unset. (code default: 150)
PLIVO_GATE_MAX_SILENCE_FAILSAFE=150


# ─── 15. PERSONA & CLIENT CONFIGURATION ─────────────────────────────────────

# Default persona loaded when none specified on inbound call.
# (code default: 'company-sales')
DEFAULT_PERSONA=company-sales
# Default language code. (code default: 'en')
DEFAULT_LANGUAGE=en

# ── company persona ──
COMPANY_TRANSFER_NUMBER=
COMPANY_NOTIFICATION_EMAIL=leads@company.com
COMPANY_BOOKING_PROVIDER=
COMPANY_BOOKING_URL=
COMPANY_BOOKING_CC_EMAIL=
COMPANY_BOOKING_DELIVERY_ENABLED=true
COMPANY_BOOKING_DELIVERY_ORDER=sms,email
COMPANY_BOOKING_MESSAGING_PROVIDER=

# ── ExEd persona ──
EXED_TRANSFER_NUMBER=
EXED_NOTIFICATION_EMAIL=registrations@ABC.com
EXED_BOOKING_PROVIDER=
EXED_BOOKING_URL=
EXED_BOOKING_CC_EMAIL=
EXED_BOOKING_DELIVERY_ENABLED=false
EXED_BOOKING_DELIVERY_ORDER=email
EXED_BOOKING_MESSAGING_PROVIDER=

# ── Dealer order persona ──
# Persona id: dealer-orders. CRM context can be passed as JSON in /api/call contextHint.
DEALER_ORDER_COMPANY_NAME=Dealer Order Desk
# HTTPS endpoint that receives confirmed dealer orders in real time.
DEALER_ORDER_ERP_ENDPOINT=
# Optional bearer token sent to DEALER_ORDER_ERP_ENDPOINT.
DEALER_ORDER_ERP_AUTH_TOKEN=
# Dealer/customer self-service order portal for missed-call fallback SMS.
DEALER_ORDER_SELF_SERVICE_URL=
# Internal order ops notification mailbox. Also used when the dealer email is unavailable.
DEALER_ORDER_NOTIFICATION_EMAIL=
DEALER_ORDER_CC_EMAIL=
# Confirmation delivery order. Supported channels: sms,email.
DEALER_ORDER_DELIVERY_ORDER=sms,email
DEALER_ORDER_SMS_ENABLED=false
DEALER_ORDER_EMAIL_ENABLED=true
DEALER_ORDER_MESSAGING_PROVIDER=auto
# Missed-call retry/fallback behavior for dealer-orders calls.
DEALER_ORDER_RETRY_ENABLED=false
DEALER_ORDER_MAX_RETRIES=2
DEALER_ORDER_RETRY_DELAY_MS=300000
DEALER_ORDER_FALLBACK_SMS_ENABLED=true

# Durable workflow action outbox worker for ERP/SMS/email side effects.
ACTION_OUTBOX_WORKER_ENABLED=true
ACTION_OUTBOX_POLL_INTERVAL_MS=5000
ACTION_OUTBOX_MAX_BATCH=5
ACTION_OUTBOX_RETRY_DELAY_MS=30000
# Dealer-order hydration read policy: workflow_first, snapshot_first, workflow_disabled.
DEALER_ORDER_READ_SOURCE_POLICY=workflow_first
# Workflow release-evidence promotion thresholds for dealer-order read graduation.
WORKFLOW_RELEASE_MIN_DARK_READ_COMPARISONS=100
WORKFLOW_RELEASE_MAX_DARK_READ_MISMATCH_RATE=0.01
WORKFLOW_RELEASE_MAX_DARK_READ_FALLBACK_RATE=0.05
WORKFLOW_RELEASE_MAX_WORKFLOW_READ_SKIPPED_RATE=0
WORKFLOW_RELEASE_MIN_RECONCILIATION_DRY_RUNS=1
WORKFLOW_RELEASE_MAX_RECONCILIATION_FAILED_REQUEUES=0
WORKFLOW_RELEASE_REQUIRE_ROLLBACK_OWNER_APPROVAL=true

# Fallback CC email for all handover notifications.
FALLBACK_CC_EMAIL=

# ── Booking links and provider webhooks ──
# Supported providers: calendly, microsoft-bookings, link. If a persona-specific
# booking URL is unset, BOOKING_LINK_URL / provider URLs below are used.
BOOKING_PROVIDER=
BOOKING_LINK_URL=
CALENDLY_BOOKING_URL=
MICROSOFT_BOOKINGS_URL=
# Set true only when provider booking pages should receive caller name/email/phone prefill fields.
BOOKING_LINK_PREFILL_PII=false
# Optional HMAC secret for tamper-resistant booking_ref correlation in generated links.
# Once set, unsigned completed/cancelled webhooks are orphaned unless legacy mode is temporarily attribute.
BOOKING_CORRELATION_SECRET=
BOOKING_CORRELATION_MAX_AGE_SECONDS=7776000
BOOKING_CORRELATION_LEGACY_MODE=orphan

# Booking-link delivery channels. Persona-specific gates above control rollout.
BOOKING_DELIVERY_ENABLED=false
BOOKING_DELIVERY_ORDER=sms,email
BOOKING_SMS_ENABLED=false
BOOKING_WHATSAPP_ENABLED=false
BOOKING_EMAIL_DISABLED=false
BOOKING_MESSAGING_PROVIDER=auto
BOOKING_SMS_REQUIRE_EXPLICIT_CONSENT=true
BOOKING_PHONE_DEFAULT_COUNTRY=US
TWILIO_MESSAGING_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
# Legacy Twilio messaging fallback alias used only if TWILIO_MESSAGING_FROM and TWILIO_FROM_NUMBER are unset.
TWILIO_PHONE_NUMBER=
PLIVO_MESSAGING_FROM=
# Legacy Plivo messaging fallback aliases used only if PLIVO_MESSAGING_FROM is unset.
PLIVO_SOURCE_NUMBER=
PLIVO_PHONE_NUMBER=
PLIVO_WHATSAPP_FROM=

# POST /booking-webhook accepts Calendly, Microsoft Bookings, and generic link callbacks.
# Generic/link callbacks use BOOKING_WEBHOOK_SECRET via x-booking-webhook-secret or Bearer auth.
BOOKING_WEBHOOK_SECRET=
# Calendly HMAC verification uses CALENDLY_WEBHOOK_SIGNING_KEY, falling back to CALENDLY_WEBHOOK_SECRET.
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_TOLERANCE_SECONDS=300
# Microsoft Bookings Graph callbacks validate clientState with this secret, falling back to BOOKING_WEBHOOK_SECRET.
MICROSOFT_BOOKINGS_WEBHOOK_SECRET=


# ─── 16. EMAIL / SMTP ───────────────────────────────────────────────────────
# Used by emailHelper.js for handover notification emails and booking-link emails.
# If SMTP_HOST, SMTP_USER, or SMTP_PASS is unset, email is silently disabled.

# SMTP server hostname (e.g. smtp.gmail.com). (REQUIRED for email)
SMTP_HOST=
# SMTP port. (code default: 587)
SMTP_PORT=587
# Set "true" for port 465 SSL; otherwise STARTTLS is used. (code default: false)
SMTP_SECURE=false
# SMTP login username. (REQUIRED for email)
SMTP_USER=
# SMTP login password / app password. (REQUIRED for email)
SMTP_PASS=
# Display name + address for outbound emails. Falls back to SMTP_USER if unset.
# Example: "VoiceBot <bot@company.com>"
SMTP_FROM=


# ─── 17. DEMOBOT ────────────────────────────────────────────────────────────

# Base URL for demobot HTML pages (origin only, no path).
# (REQUIRED for demobot — MainController.js)
# Example: https://your-n8n-host.example.com
DEMOBOT_BASE_URL=
# Optional path appended to DEMOBOT_BASE_URL. No default.
DEMOBOT_PATH=


# ─── 18. DATABASE ───────────────────────────────────────────────────────────

# MySQL connection details. (REQUIRED — services/db.js)
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=voicebot
# MySQL connection pool limit. (code default: 25)
DB_CONNECTION_LIMIT=25


# ─── 19. CALLING WINDOW & CONSENT ───────────────────────────────────────────

# Enforce calling-hours window. On when unset; set "false" to disable.
# (callingWindowCheck.js — defaults to enabled)
CALLING_WINDOW_ENABLED=
# Require explicit recording consent before call proceeds.
# (code default: false — enforced by services/outboundCallCompliance.js and app startup warning)
CONSENT_CHECK_ENABLED=false
# Non-production escape hatch for consent/calling-window gates. Suppression/DNC is never bypassed.
COMPLIANCE_BYPASS=false


# ─── 20. TELEMETRY & MONITORING ─────────────────────────────────────────────

# Master telemetry switch. (code default: false — Utils/logger.js)
# ⚠ Must be true in production for observability (App Insights, metrics, alerts).
VOICEBOT_TELEMETRY=true
# Azure Monitor connection string. Primary key for Application Insights.
# (azureTelemetryAdapter.js checks AZURE_MONITOR_CONNECTION_STRING first,
#  then falls back to APPLICATIONINSIGHTS_CONNECTION_STRING)
AZURE_MONITOR_CONNECTION_STRING=
# ⚠ Bug fix: code reads APPLICATIONINSIGHTS_CONNECTION_STRING (with LICATION),
# not the shorter APPINSIGHTS_CONNECTION_STRING that was listed previously.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Azure Monitor OpenTelemetry resource identity. Helps Application Map and
# Workbooks group telemetry by environment/instance.
OTEL_SERVICE_NAME=voicebot
OTEL_SERVICE_NAMESPACE=voicebot
OTEL_SERVICE_INSTANCE_ID=
# Optional trace sampling controls. Custom business events are emitted as logs;
# metrics are never sampled by Azure Monitor.
OTEL_TRACES_SAMPLER=microsoft.rate_limited
OTEL_TRACES_SAMPLER_ARG=1.5
# Service debug logging level. Blank = default.
LOG_LEVEL=
# Redact call content in logs and conversation persistence.
# Keep true in production. Set false only for controlled validation where raw
# transcripts, bot responses, phone numbers, and emails are required.
VOICEBOT_REDACT_CALL_CONTENT=true
# Controlled text debug escape hatch. Keep disabled in production unless tracing named call IDs.
VOICEBOT_DEBUG_TEXT_LOGS=false
VOICEBOT_DEBUG_TEXT_CALL_IDS=
# Backward-compatible alias for VOICEBOT_DEBUG_TEXT_CALL_IDS.
VOICEBOT_DEBUG_CALL_IDS=
VOICEBOT_DEBUG_TEXT_MAX_CHARS=400

# Business telemetry model. Values are estimates used only for dashboard KPIs.
# Keep unset/0 until finance or campaign owners provide approved values.
VOICEBOT_REVENUE_MODEL=env_estimate_v1
VOICEBOT_COST_MODEL=env_estimate_v1
VOICEBOT_BOOKING_COMPLETED_VALUE_USD=0
VOICEBOT_BOOKING_LINK_VALUE_USD=0
VOICEBOT_BOOKING_REQUEST_VALUE_USD=0
VOICEBOT_DEALER_ORDER_CONFIRMED_VALUE_USD=0
VOICEBOT_TRANSFER_REQUEST_VALUE_USD=0
VOICEBOT_TRANSFER_VALUE_USD=0
VOICEBOT_COST_PER_CALL_USD=0
VOICEBOT_COST_PER_MINUTE_USD=0
VOICEBOT_INPUT_TOKEN_COST_PER_1K_USD=0
VOICEBOT_OUTPUT_TOKEN_COST_PER_1K_USD=0


# ─── 21. PHASE 3 — LATENCY & RESPONSIVENESS ─────────────────────────────────
# Global kill switch. If false, all Phase 3 is disabled.
# (code default: false — latencyResponsivenessConfig.js)
# ⚠ Must be true in production — enables latency budgeting, overrun logging,
# compensation engine, pacing, prewarm, and micro-acknowledgements.
PHASE3_ENABLED=true
# Extra debug logging for Phase 3. (code default: false)
PHASE3_DEBUG=false

# ── Latency Budget (ms) — overruns logged when PHASE3_ENABLED ──
# speechEnd → responseStart target. (code default: 800)
PHASE3_LATENCY_RESPONSE_MS=800
# responseStart → firstAudio target. (code default: 700)
# Azure phi4-mm-realtime model inference typically 400-650ms.
PHASE3_LATENCY_FIRST_AUDIO_MS=700
# Total budget: speechEnd → firstAudio. (code default: 1200)
PHASE3_LATENCY_TOTAL_MS=1200
# Log overruns. (code default: true — checked !== 'false')
PHASE3_LATENCY_LOG_OVERRUNS=true

# ── Latency Compensation — adaptive context/KB reduction ──
# Enable compensation engine. (code default: false)
PHASE3_LATENCY_COMPENSATION_ENABLED=true
# Rolling window size for overrun tracking. (code default: 5)
PHASE3_LATENCY_WINDOW_SIZE=5
# Overruns in window to trigger LIGHT mode. (code default: 2)
PHASE3_LATENCY_LIGHT_THRESHOLD=2
# Overruns in window to trigger AGGRESSIVE mode. (code default: 5)
PHASE3_LATENCY_AGGRESSIVE_THRESHOLD=5
# Max context turns in LIGHT mode. (code default: 6)
PHASE3_LATENCY_LIGHT_MAX_CONTEXT=6
# Max context turns in AGGRESSIVE mode. (code default: 5)
PHASE3_LATENCY_AGGRESSIVE_MAX_CONTEXT=5
# Skip KB retrieval in AGGRESSIVE mode. (code default: false)
# ⚠ Setting true removes all factual grounding — not recommended.
PHASE3_LATENCY_SKIP_KB=false
# Enable filler audio ("Just a moment...") during latency. (code default: false)
# Prevents dead air when inference takes >800ms. Humans tolerate 700ms silence
# max before perceiving a stall. Filler bridges the gap naturally.
PHASE3_LATENCY_FILLER_ENABLED=true

# ── Prewarm — pre-fetch KB before user finishes speaking ──
# (code default: false)
# ⚠ Recommended true — pre-fetches KB while user is still speaking.
# Saves 100-200ms on response latency for KB-grounded answers.
PHASE3_PREWARM_ENABLED=true

# ── Pacing — split long TTS, insert natural pauses ──
# (code default: true — checked !== 'false')
PHASE3_PACING_ENABLED=true
# Maximum TTS chunk duration before pause (ms). (code default: 4000)
PHASE3_PACING_CHUNK_MS=4000
# Pause range between chunks (ms). (code defaults: 50–150)
PHASE3_PACING_PAUSE_MIN_MS=50
PHASE3_PACING_PAUSE_MAX_MS=150

# ── Micro-Acknowledgements — "mm-hmm" during long user speech ──
# (code default: false)
# ⚠ Recommended true — mimics human backchannel behavior ("mm-hmm").
# In human calls, listeners signal attention every 3-5s of speaker speech.
# Reduces caller anxiety that the bot has "frozen" during long questions.
PHASE3_MICRO_ACK_ENABLED=true
# Allow test-confidence override (test-only flag). (code default: false)
PHASE3_MICRO_ACK_ALLOW_TEST_CONFIDENCE=false
# Confidence threshold to trigger micro-ack. (code default: 0.7)
# ⚠ .env.example previously said 0.8, but code default is 0.7.
PHASE3_MICRO_ACK_CONFIDENCE=0.7
# Min continuous speech duration to trigger micro-ack (ms). (code default: 200)
# ⚠ .env.example previously said 300, but code default is 200.
PHASE3_MICRO_ACK_SPEECH_MIN_MS=200
# Max continuous speech duration for micro-ack window (ms). (code default: 600)
# ⚠ .env.example previously said 800, but code default is 600.
PHASE3_MICRO_ACK_SPEECH_MAX_MS=600
# Path to neutral audio file for micro-ack. Null = no file.
PHASE3_MICRO_ACK_NEUTRAL_AUDIO_PATH=


# ─── 22. PHASE 4 — CONVERSATIONAL INTELLIGENCE ──────────────────────────────

# Global kill switch. If false, all Phase 4 modules are disabled
# (no RAG guardrails, no intent gate, no persona profile, no escalation).
# (code default: false — phase4Config.js)
# Sprint 6E: Enabled — activates KB score ranking, RAG guardrails,
# complexity-adaptive tokens/temperature, and post-generation quality gate.
PHASE4_ENABLED=true
# Profile selection at call start. Options: structured, balanced, rapid.
# (code default: 'balanced' — invalid values silently fall back to balanced)
PHASE4_PROFILE=balanced
# Sigmoid midpoint for KB relevance normalization. (code default: 10)
KB_SCORE_SIGMOID_K=10


# ─── 23. PHASE 2.5 — UNLOCK & DEGRADATION ───────────────────────────────────

# Debug logging for Phase 2.5.2 unlock system. (code default: false)
PHASE2_5_2_UNLOCK_DEBUG=false


# ─── 24. TIERED LATENCY CONFIGURATION ───────────────────────────────────────
# Per-tier overrides for simple/medium/complex query processing.
# All values have sensible code defaults; only set what you need to tune.
# Temperature values below are intentional production overrides (lower than
# code defaults of 0.6/0.8/1.0) for more deterministic voice responses.

# ── Simple Tier (one-line answers, acknowledgements) ──
# Code defaults: maxTokens=50, maxDocs=2, semanticWeight=0.8,
#   keywordWeight=0.2, rerank=false, temperature=0.6, targetLatency=300,
#   sttEarlyFinalization=true, ttsStreaming=true
TIERED_SIMPLE_MAX_TOKENS=50
TIERED_SIMPLE_MAX_DOCS=2
TIERED_SIMPLE_SEMANTIC_WEIGHT=0.8
TIERED_SIMPLE_KEYWORD_WEIGHT=0.2
TIERED_SIMPLE_RERANK=false
TIERED_SIMPLE_TEMPERATURE=0.1
TIERED_SIMPLE_TARGET_LATENCY=300
TIERED_SIMPLE_STT_EARLY_FINALIZATION=true
TIERED_SIMPLE_TTS_STREAMING=true

# ── Medium Tier (product questions, follow-ups) ──
# Code defaults: maxTokens=100, maxDocs=3, semanticWeight=0.6,
#   keywordWeight=0.4, rerank=false, temperature=0.8, targetLatency=500,
#   sttEarlyFinalization=true, ttsStreaming=true
TIERED_MEDIUM_MAX_TOKENS=100
TIERED_MEDIUM_MAX_DOCS=3
TIERED_MEDIUM_SEMANTIC_WEIGHT=0.6
TIERED_MEDIUM_KEYWORD_WEIGHT=0.4
TIERED_MEDIUM_RERANK=false
TIERED_MEDIUM_TEMPERATURE=0.3
TIERED_MEDIUM_TARGET_LATENCY=500
TIERED_MEDIUM_STT_EARLY_FINALIZATION=true
TIERED_MEDIUM_TTS_STREAMING=true

# ── Complex Tier (technical deep-dives, multi-part questions) ──
# Code defaults: maxTokens=200, maxDocs=5, semanticWeight=0.5,
#   keywordWeight=0.3, exactWeight=0.2, rerank=true, temperature=1.0,
#   targetLatency=1000, sttEarlyFinalization=false, ttsStreaming=true
TIERED_COMPLEX_MAX_TOKENS=200
TIERED_COMPLEX_MAX_DOCS=5
TIERED_COMPLEX_SEMANTIC_WEIGHT=0.5
TIERED_COMPLEX_KEYWORD_WEIGHT=0.3
TIERED_COMPLEX_EXACT_WEIGHT=0.2
TIERED_COMPLEX_RERANK=true
TIERED_COMPLEX_TEMPERATURE=0.5
TIERED_COMPLEX_TARGET_LATENCY=1000
TIERED_COMPLEX_STT_EARLY_FINALIZATION=false
TIERED_COMPLEX_TTS_STREAMING=true


# ─── 25. MODEL ROUTER / A/B TESTING ─────────────────────────────────────────

# Enable model routing (default: disabled). (code default: false)
MODEL_ROUTER_ENABLED=false
# Enable A/B experiment split between Azure and OpenAI. (code default: false)
MODEL_ROUTER_AB_ENABLED=false
# Percentage of calls routed to OpenAI experiment cohort (0–100). (code default: 0)
MODEL_ROUTER_AB_GPT4O_PERCENT=0
# OpenAI endpoint and key for experiment cohort.
MODEL_ROUTER_GPT4O_ENDPOINT=
MODEL_ROUTER_GPT4O_API_KEY=


# ─── 26. RAG SYNTHESIS ──────────────────────────────────────────────────────

# Enable RAG synthesis scoring pipeline. (code default: false)
RAG_SYNTHESIS_ENABLED=false
# Number of top docs passed to synthesis. (code default: 3)
RAG_SYNTHESIS_TOP_N=3


# ─── 27. CI / TEST HARNESS (not needed in production) ───────────────────────

# These are only used by CI scripts in ci/scripts/. Safe to omit in production.
# HARNESS_STRESS=false        — ci/scripts/run-synthetic-harness.js
# MEMORY_RELAX=false          — ci/scripts/check-memory-regression.js
# LATENCY_RELAX=false         — ci/scripts/check-latency-regression.js
# GITHUB_BASE_REF=            — ci/scripts/check-diff-guard.js
