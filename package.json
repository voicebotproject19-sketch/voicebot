{
  "name": "AI-sales-representative",
  "version": "1.1.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon app.js",
    "start": "node app.js",
    "lint": "node -e \"console.log('Lint step intentionally skipped (no ESLint configured)')\"",
    "smoke:demo": "bash scripts/smoke-demo.sh",
    "test": "jest",
    "test:ci": "jest --ci --verbose",
    "test:audio-transcode": "jest tests/audioTranscode.test.js",
    "validate:ai-adapters": "node ci/scripts/check-adapter-contract.js && node ci/scripts/check-adapter-compliance.js",
    "validate:provider-abstraction": "node ci/scripts/check-provider-behavior-drift.js",
    "validate:phase3-deterministic": "node ci/scripts/run-phase3-deterministic.js",
    "validate:phase3-surface": "npm run validate:ai-adapters && npm run validate:provider-abstraction && npm run validate:phase3-deterministic && npm run test:audio-transcode",
    "validate:hold-music": "jest tests/hold-music-asset.test.js",
    "validate:env": "node ci/scripts/check-env-contract.js",
    "validate:telemetry": "node ci/scripts/check-telemetry-contract.js && node ci/scripts/check-telemetry-completeness.js && node ci/scripts/check-event-schema.js && node ci/scripts/check-observability-metrics.js",
    "validate:workflows": "node ci/scripts/check-workflow-manifest.js"
  },
  "keywords": [],
  "author": "Charlie Weems",
  "license": "MIT",
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.16.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.208.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.12.15",
    "multer": "^2.0.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^8.0.4",
    "openai": "^4.53.0",
    "plivo": "^4.75.7",
    "twilio": "^5.12.2",
    "uuid": "^9.0.1",
    "websocket-express": "^4.0.1",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "form-data": "^4.0.0",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.3"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.4.11",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.0.0",
    "acorn": "^8.11.3",
    "acorn-walk": "^8.3.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9"
  }
}
